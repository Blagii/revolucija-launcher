{
  "name": "revolucija-launcher",
  "version": "2.2.0",
  "description": "Zvanični launcher za Revolucija Roleplay — GTA V RP (FiveM) server",
  "main": "src/main.js",
  "private": true,
  "author": "Revolucija Roleplay",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.js",
    "test": "node scripts/smoke-test.js",
    "dist": "electron-builder",
    "dist:publish": "electron-builder --publish always"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "gg.revolucija.launcher",
    "productName": "Revolucija Launcher",
    "copyright": "Copyright © Revolucija Roleplay",
    "publish": [
      {
        "provider": "github",
        "owner": "Seekiii",
        "repo": "revolucija-launcher"
      }
    ],
    "files": [
      "src/**",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "shortcutName": "Revolucija Launcher",
      "artifactName": "RevolucijaLauncher-Setup-${version}.${ext}",
      "target": [
        "nsis",
        "portable"
      ],
      "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "Revolucija Launcher"
      }
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games",
      "artifactName": "RevolucijaLauncher-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "RevolucijaLauncher-${version}-${arch}.${ext}"
    }
  }
}
