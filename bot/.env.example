# Discord Developer Portal → Application → Bot → Token
DISCORD_TOKEN=
# Application ID (isti ID koji koristiš i za Discord Rich Presence u launcheru)
DISCORD_CLIENT_ID=
# Server (Guild) ID gde se registruju slash komande — registracija je trenutna
DISCORD_GUILD_ID=
# Kanal u koji bot POST-uje objave (tekstualni kanal)
ANNOUNCEMENTS_CHANNEL_ID=
# (Opcionalno) Role ID koja sme /najava i /obrisi-najavu.
# Bez nje, staff provera pada na Discord dozvolu "Manage Messages".
STAFF_ROLE_ID=
# Uživo status za /status komandu (tvoj FiveM server dynamic.json)
FIVEM_DYNAMIC_URL=http://89.116.184.110:30120/dynamic.json
# HTTP endpoint koji launcher čita kao announcementUrl
BOT_HTTP_BIND=0.0.0.0
BOT_HTTP_PORT=8734
# Gde se čuvaju objave (JSON, atomski zapis)
BOT_DATA_FILE=./data/announcements.json
